{% capture footer_contents %}
  &copy; Copyright {{ site.time | date: '%Y' }}
  {{ site.first_name }}
  {{ site.middle_name }}
  {{ site.last_name }}. {{ site.footer_text }}
  {% if site.impressum_path %}
    <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
  {% endif %}
  {% if site.last_updated %}
    Last updated: {{ 'now' | date: '%B %d, %Y' }}.
  {% endif %}
{% endcapture %}

{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      {{ footer_contents }}
    </div>
    <div style="position: fixed; bottom: 10px; left: 10px; font-size: 14px;">
      <a href='http://www.freevisitorcounters.com'>Counter</a>
      <script type='text/javascript' src='https://www.freevisitorcounters.com/auth.php?id=16235ab68d7072e76bec5941f84443e7a88c5e31'></script>
      <script type="text/javascript" src="https://www.freevisitorcounters.com/en/home/counter/1387691/t/0"></script>
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% include newsletter.liquid %}
    {% endif %}

    <div class="container">
      {{ footer_contents }}
    </div>
    <div style="position: fixed; bottom: 10px; left: 10px; font-size: 14px;">
      <a href='http://www.freevisitorcounters.com'>Counter</a>
      <script type='text/javascript' src='https://www.freevisitorcounters.com/auth.php?id=16235ab68d7072e76bec5941f84443e7a88c5e31'></script>
      <script type="text/javascript" src="https://www.freevisitorcounters.com/en/home/counter/1387691/t/0"></script>
    </div>
  </footer>
{% endif %}
